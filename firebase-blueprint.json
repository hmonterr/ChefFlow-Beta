{
  "entities": {
    "Recipe": {
      "title": "Recipe",
      "description": "A recipe that contributes ingredients to the shopping list.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the recipe." },
        "title": { "type": "string", "description": "Display name of the recipe." },
        "isActive": { "type": "boolean", "description": "Whether the recipe's ingredients should be active/displayed." },
        "multiplier": { "type": "number", "description": "Scale factor for ingredient quantities." },
        "userId": { "type": "string", "description": "Owner of the recipe." }
      },
      "required": ["id", "title", "isActive", "multiplier", "userId"]
    },
    "Ingredient": {
      "title": "Ingredient",
      "description": "An ingredient item in the shopping list.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the ingredient." },
        "recipeId": { "type": "string", "description": "Reference to parent recipe, or 'manual'." },
        "name": { "type": "string", "description": "Standardized name of the ingredient." },
        "quantity": { "type": "number", "description": "Total scaled quantity." },
        "unit": { "type": "string", "description": "Base unit for calculations." },
        "category": { "type": "string", "description": "Grocery category/department." },
        "checked": { "type": "boolean", "description": "Whether the item is crossed off the list." },
        "isManual": { "type": "boolean", "description": "If the item was added manually." },
        "mpuQuantity": { "type": "number", "description": "Market Purchase Unit quantity." },
        "mpuUnit": { "type": "string", "description": "Market Purchase Unit label." },
        "originalQuantity": { "type": "number", "description": "The quantity before scaling." },
        "originalUnit": { "type": "string", "description": "The unit before normalization." },
        "lineage": { "type": "array", "description": "Track source recipes or manual reasons." },
        "hideQuantity": { "type": "boolean", "description": "Whether to hide the count UI." },
        "displayString": { "type": "string", "description": "Formatted quantity string (e.g., '1 lb')." },
        "displayOverride": { "type": "string", "description": "Manual text override for display." },
        "userId": { "type": "string", "description": "Owner of the ingredient." }
      },
      "required": ["id", "recipeId", "name", "quantity", "unit", "category", "checked", "userId"]
    },
    "LibraryRecipe": {
      "title": "Library Recipe",
      "description": "A recipe saved to the user's permanent library.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier." },
        "title": { "type": "string", "description": "Display name." },
        "ingredients": { "type": "array", "description": "Bundled ingredients for this recipe." },
        "userId": { "type": "string", "description": "Owner." },
        "savedAt": { "type": "string", "description": "ISO timestamp of when it was saved." }
      },
      "required": ["id", "title", "ingredients", "userId"]
    }
  },
  "firestore": {
    "/recipes/{recipeId}": {
      "schema": "Recipe",
      "description": "User recipes collection."
    },
    "/ingredients/{ingredientId}": {
      "schema": "Ingredient",
      "description": "User ingredients collection."
    },
    "/library_recipes/{recipeId}": {
      "schema": "LibraryRecipe",
      "description": "Permanent library recipes."
    }
  }
}
